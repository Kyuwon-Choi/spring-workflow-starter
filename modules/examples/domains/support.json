          },
          "writes": {
            "response": "response"
          },
          "requires": [],
          "extension": null
        },
        "close": {
          "label": "종료하기",
          "from": [
            "ANSWERED"
          ],
          "target": "CLOSED",
          "roles": [
            "ROLE_USER",
            "ROLE_ADMIN"
          ],
          "scope": "OWN",
          "inputs": {},
          "writes": {},
          "requires": [
            "response"
          ],
          "extension": null
        }
