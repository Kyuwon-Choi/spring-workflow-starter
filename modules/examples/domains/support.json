        "code": {
          "label": "고객 코드",
          "type": "string",
          "required": true,
          "maxLength": 40
        },
        "name": {
          "label": "고객명",
          "type": "string",
          "required": true,
          "maxLength": 100
        },
        "email": {
          "label": "이메일",
          "type": "string",
          "required": false,
          "maxLength": 160
        }
      },
      "states": [
        "ACTIVE"
      ],
      "initialState": "ACTIVE",
      "readRoles": [
        "ROLE_USER",
        "ROLE_ADMIN"
      ],
      "readScope": "ALL",
      "managerRoles": [
        "ROLE_ADMIN"
      ],
      "createRoles": [
        "ROLE_USER",
        "ROLE_ADMIN"
      ],
      "actions": {}
    },
    "ticket": {
      "label": "문의",
      "labelField": "title",
      "keyField": null,
      "fields": {
        "title": {
          "label": "문의 제목",
          "type": "string",
          "required": true,
          "maxLength": 160
