            "NORMAL",
            "HIGH"
          ]
        },
        "response": {
          "label": "답변",
          "type": "string",
          "required": false,
          "maxLength": 2000
        }
      },
      "states": [
        "OPEN",
        "ANSWERED",
        "CLOSED"
      ],
      "initialState": "OPEN",
      "readRoles": [
        "ROLE_USER",
        "ROLE_ADMIN"
      ],
      "readScope": "OWN",
      "managerRoles": [
        "ROLE_ADMIN"
      ],
      "createRoles": [
        "ROLE_USER",
        "ROLE_ADMIN"
      ],
      "actions": {
        "reply": {
          "label": "답변하기",
          "from": [
            "OPEN"
          ],
          "target": "ANSWERED",
          "roles": [
            "ROLE_USER",
            "ROLE_ADMIN"
          ],
          "scope": "OWN",
          "inputs": {
            "response": {
              "label": "답변",
              "type": "string",
              "required": true,
              "maxLength": 2000
