<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
 <changeSet id="20261028000000" author="fde-kit">
  <createTable tableName="fde_object">
   <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
   <column name="domain_id" type="varchar(64)"><constraints nullable="false"/></column>
   <column name="object_type" type="varchar(64)"><constraints nullable="false"/></column>
   <column name="business_key" type="varchar(255)"/>
   <column name="payload" type="clob"><constraints nullable="false"/></column>
   <column name="state" type="varchar(64)"><constraints nullable="false"/></column>
   <column name="owner" type="varchar(50)"><constraints nullable="false"/></column>
   <column name="version" type="bigint"><constraints nullable="false"/></column>
   <column name="created_at" type="timestamp"><constraints nullable="false"/></column>
  </createTable>
  <addUniqueConstraint tableName="fde_object" columnNames="domain_id,object_type,business_key" constraintName="ux_fde_business_key"/>
  <createIndex tableName="fde_object" indexName="ix_fde_scope"><column name="domain_id"/><column name="object_type"/><column name="owner"/></createIndex>
  <createTable tableName="fde_audit">
   <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
   <column name="object_id" type="bigint"><constraints nullable="false"/></column>
   <column name="actor" type="varchar(50)"><constraints nullable="false"/></column>
   <column name="action" type="varchar(64)"><constraints nullable="false"/></column>
   <column name="before_data" type="clob"/>
   <column name="after_data" type="clob"><constraints nullable="false"/></column>
   <column name="before_state" type="varchar(64)"/>
   <column name="after_state" type="varchar(64)"><constraints nullable="false"/></column>
   <column name="occurred_at" type="timestamp"><constraints nullable="false"/></column>
  </createTable>
  <addForeignKeyConstraint baseTableName="fde_audit" baseColumnNames="object_id" referencedTableName="fde_object" referencedColumnNames="id" constraintName="fk_fde_audit_object"/>
  <createIndex tableName="fde_audit" indexName="ix_fde_audit_object"><column name="object_id"/></createIndex>
 </changeSet>
</databaseChangeLog>
