{
  "id": "events",
  "label": "Test-only fourth domain",
  "types": {
    "event": {
      "label": "Event",
      "labelField": "title",
      "fields": {
        "title": {
          "label": "Title",
          "type": "string",
          "required": true
        },
        "capacity": {
          "label": "Capacity",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 1000
        },
        "date": {
          "label": "Date",
          "type": "date",
          "required": true
        },
        "parent": {
          "label": "Related event",
          "type": "reference",
          "required": false,
          "reference": "event"
        }
      },
      "states": [
        "PLANNED",
        "PUBLISHED"
      ],
      "initialState": "PLANNED",
      "readRoles": [
        "ROLE_USER",
        "ROLE_ADMIN"
      ],
      "readScope": "ALL",
      "managerRoles": [
        "ROLE_ADMIN"
      ],
      "createRoles": [
        "ROLE_USER",
        "ROLE_ADMIN"
      ],
      "actions": {
        "publish": {
          "label": "Publish",
          "from": [
            "PLANNED"
          ],
          "target": "PUBLISHED",
          "roles": [
            "ROLE_USER",
            "ROLE_ADMIN"
          ],
          "scope": "ALL",
          "inputs": {},
          "writes": {},
          "requires": []
        },
        "link": {
          "label": "Link event",
          "from": [
            "PLANNED"
          ],
          "target": "PLANNED",
          "roles": [
            "ROLE_USER",
            "ROLE_ADMIN"
          ],
          "scope": "ALL",
          "inputs": {
            "related": {
              "label": "Related event",
              "type": "reference",
              "required": true,
              "reference": "event"
            }
          },
          "writes": {
            "parent": "related"
          },
          "requires": []
        }
      }
    }
  }
}
